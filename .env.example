# ============================================================
# AeroSentinel Environment Configuration Template
# Copy this file to .env and populate the required values.
# NEVER commit real credentials to version control.
# ============================================================

# Application Environment
SPRING_PROFILES_ACTIVE=dev
PORT=8080
FRONTEND_PORT=3000
AI_SERVICE_PORT=8000

# PostgreSQL + PostGIS Database Configuration
POSTGRES_DB=aerosentinel
POSTGRES_USER=aerosentinel_user
POSTGRES_PASSWORD=change_this_in_production
DATABASE_URL=jdbc:postgresql://localhost:5432/aerosentinel
DATABASE_USERNAME=aerosentinel_user
DATABASE_PASSWORD=change_this_in_production

# JWT / Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Internal AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# External Environmental APIs (Mock/Fallback enabled if left blank)
CPCB_API_KEY=
CPCB_BASE_URL=https://api.cpcb.gov.in
FIRMS_API_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
SENTINEL_GEE_PROJECT_ID=
SENTINEL_SERVICE_ACCOUNT_KEY=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage Paths
UPLOAD_DIR=./storage/uploads/citizen_reports
MODEL_DIR=./ai-service/artifacts/models
